// Version literals this project owns, checked by doneram. The weekly
// Freshness workflow patches them and opens draft PRs.
//
// Most pins need no entry: doneram discovers GitHub Actions, mise tools,
// and Terraform pins on its own, scans lockfiles and go.mod for advisories,
// and reports end-of-life runtimes. Pins in files my_go_template maintains
// (the workflows, .config/mise/conf.d/template.toml, hk.pkl) are left to
// the template on purpose: its next release carries them, and the copier
// update this workflow proposes brings them here, so patching them locally
// would only make that update a merge. A version literal discovery cannot
// see, in a Dockerfile, a script, or a file this project added, goes below.

amends "package://github.com/kyleking/doneram/releases/download/v2.0.0/doneram@2.0.0#/Config.pkl"
import "package://github.com/kyleking/doneram/releases/download/v2.0.0/doneram@2.0.0#/Config.pkl"

/// Run before a weekly PR opens: a bump that breaks it is bisected out
/// into its own PR, so the rest still merge.
validate = "mise run ci"

tools = new {
  ["doneram-schema"] = new {
    resolver = "github-release"
    resolverName = "kyleking/doneram"
    sites = new {
      new Config.Site {
        file = ".doneram.pkl"
        pattern = #"releases/download/v([\d.]+)/doneram"#
      }
      new Config.Site {
        file = ".doneram.pkl"
        pattern = #"doneram@([\d.]+)#/Config\.pkl"#
      }
    }
  }
}
