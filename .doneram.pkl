// Tool versions shipped to generated projects. Each one is a literal in the file
// that consumes it. This file records where those literals are and how to resolve
// the latest value. go and python are absent on purpose, because they set the
// language level a generated project targets and stay copier answers.
//
// A site that matches a different number of times than `expect` fails the run.
// A pattern that silently stops matching is how a pin goes stale unnoticed.
//
// The schema is inlined so this file evaluates today. It amends doneram's
// published Config.pkl once doneram ships a pkl package.

class Site {
  /// Repo-relative path to the file holding the literal.
  file: String
  /// Regex with exactly one capture group around the version.
  pattern: String
  expect: Int(this > 0) = 1
}

/// Keeps taking updates below `max`, so a known break blocks only the majors
/// past it rather than freezing the pin.
class Hold {
  reason: String
  max: String?
}

class Tool {
  resolver: String = "mise"
  /// Name to query when it differs from the map key, e.g. "pipx:commitizen".
  resolverName: String?
  sites: Listing<Site>
  hold: Hold?
}

/// Brings the rendered .ctt output back in sync after any patch.
afterPatch: String = "./sync_with_ctt.sh"

local miseToml = "go_template/.config/mise/conf.d/template.toml.jinja"
local hkPkl = "go_template/hk.pkl.jinja"
local ciYml = "go_template/.github/workflows/ci.yml.jinja"
local rootCiYml = ".github/workflows/ci.yml"
local rootBumpYml = ".github/workflows/bump_version.yml"
local bumpYml = "go_template/.github/workflows/bump_version.yml.jinja"
local publishYml = "go_template/.github/workflows/publish.yml.jinja"
local freshnessYml = ".github/workflows/freshness.yml"
local rootMiseToml = "mise.toml"

/// A bare mise tool key, e.g. `actionlint = "1.7.12"`.
local function misePin(key: String): Site = new {
  file = miseToml
  pattern = #"\#(key) = "([\d.]+)""#
}

/// A quoted mise tool key, e.g. `"golangci-lint" = "2.12.2"`.
local function quotedMisePin(key: String): Site = new {
  file = miseToml
  pattern = #""\#(key)" = "([\d.]+)""#
}

/// A `uses: owner/repo@<sha> # <tag>` GitHub Action pin, one capture group
/// spanning the sha and the tag together, since github-action patches both
/// as a single resolved value.
local function actionPin(action: String, sourceFile: String, count: Int): Site = new {
  file = sourceFile
  pattern = #"\#(action)@([0-9a-f]{40} # v[\d.]+)"#
  expect = count
}

tools: Mapping<String, Tool> = new {
  ["action-gh-release"] = new {
    resolver = "github-action"
    resolverName = "softprops/action-gh-release"
    sites = new {
      actionPin("softprops/action-gh-release", rootBumpYml, 1)
      actionPin("softprops/action-gh-release", bumpYml, 1)
    }
  }
  ["actionlint"] = new {
    sites = new { misePin("actionlint") }
  }
  ["checkout"] = new {
    resolver = "github-action"
    resolverName = "actions/checkout"
    sites = new {
      actionPin("actions/checkout", rootCiYml, 1)
      actionPin("actions/checkout", rootBumpYml, 1)
      actionPin("actions/checkout", ciYml, 6)
      actionPin("actions/checkout", bumpYml, 1)
      actionPin("actions/checkout", publishYml, 3)
      actionPin("actions/checkout", freshnessYml, 1)
    }
  }
  ["commitizen"] = new {
    resolverName = "pipx:commitizen"
    sites = new { quotedMisePin("pipx:commitizen") }
  }
  ["create-pull-request"] = new {
    resolver = "github-action"
    resolverName = "peter-evans/create-pull-request"
    sites = new { actionPin("peter-evans/create-pull-request", freshnessYml, 1) }
  }
  ["download-artifact"] = new {
    resolver = "github-action"
    resolverName = "actions/download-artifact"
    sites = new { actionPin("actions/download-artifact", publishYml, 1) }
  }
  ["golangci-lint"] = new {
    sites = new {
      quotedMisePin("golangci-lint")
      new Site {
        file = ciYml
        pattern = #"version: v([\d.]+)"#
      }
    }
  }
  ["golangci-lint-action"] = new {
    resolver = "github-action"
    resolverName = "golangci/golangci-lint-action"
    sites = new { actionPin("golangci/golangci-lint-action", ciYml, 1) }
  }
  ["golines"] = new {
    resolverName = "go:github.com/golangci/golines"
    sites = new {
      new Site {
        file = miseToml
        pattern = #""go:github\.com/golangci/golines" = "([\d.]+)""#
      }
    }
  }
  ["goreleaser-action"] = new {
    resolver = "github-action"
    resolverName = "goreleaser/goreleaser-action"
    sites = new {
      actionPin("goreleaser/goreleaser-action", bumpYml, 1)
      actionPin("goreleaser/goreleaser-action", publishYml, 1)
    }
  }
  ["hk"] = new {
    sites = new {
      misePin("hk")
      // amends and import each carry the version twice, and pkl cannot
      // interpolate a local into either, so all four literals move together.
      new Site {
        file = hkPkl
        pattern = #"download/v([\d.]+)/hk@"#
        expect = 2
      }
      new Site {
        file = hkPkl
        pattern = #"hk@([\d.]+)#"#
        expect = 2
      }
      new Site {
        file = hkPkl
        pattern = #"min_hk_version = "([\d.]+)""#
      }
    }
  }
  ["jq"] = new {
    sites = new { misePin("jq") }
  }
  ["ls-lint"] = new {
    sites = new { misePin("ls-lint") }
  }
  ["mise-action"] = new {
    resolver = "github-action"
    resolverName = "jdx/mise-action"
    sites = new {
      actionPin("jdx/mise-action", ciYml, 4)
      actionPin("jdx/mise-action", freshnessYml, 1)
    }
  }
  ["pkl"] = new {
    sites = new {
      misePin("pkl")
      new Site {
        file = rootMiseToml
        pattern = #"pkl = "([\d.]+)""#
      }
    }
  }
  ["setup-go"] = new {
    resolver = "github-action"
    resolverName = "actions/setup-go"
    sites = new {
      actionPin("actions/setup-go", rootCiYml, 1)
      actionPin("actions/setup-go", ciYml, 3)
      actionPin("actions/setup-go", bumpYml, 1)
      actionPin("actions/setup-go", publishYml, 2)
      actionPin("actions/setup-go", freshnessYml, 1)
    }
  }
  ["setup-uv"] = new {
    resolver = "github-action"
    resolverName = "astral-sh/setup-uv"
    sites = new {
      actionPin("astral-sh/setup-uv", rootCiYml, 1)
      actionPin("astral-sh/setup-uv", publishYml, 3)
      actionPin("astral-sh/setup-uv", freshnessYml, 1)
    }
  }
  ["shellcheck"] = new {
    sites = new { misePin("shellcheck") }
  }
  ["tombi"] = new {
    sites = new { misePin("tombi") }
  }
  ["typos"] = new {
    sites = new { misePin("typos") }
  }
  ["upload-artifact"] = new {
    resolver = "github-action"
    resolverName = "actions/upload-artifact"
    sites = new {
      actionPin("actions/upload-artifact", ciYml, 2)
      actionPin("actions/upload-artifact", publishYml, 2)
    }
  }
  ["uv"] = new {
    sites = new { misePin("uv") }
  }
  ["yamllint"] = new {
    resolverName = "pipx:yamllint"
    sites = new { quotedMisePin("pipx:yamllint") }
  }
}
