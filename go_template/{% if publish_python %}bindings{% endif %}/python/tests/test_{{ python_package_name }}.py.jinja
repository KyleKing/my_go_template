from __future__ import annotations

import subprocess
import sys

import {{ python_package_name }}


def test_run_trims_surrounding_whitespace() -> None:
    assert {{ python_package_name }}.run('  hello  ') == 'hello'


def test_run_is_idempotent() -> None:
    once = {{ python_package_name }}.run('hello world\n')
    assert {{ python_package_name }}.run(once) == once


def test_run_accepts_empty_input() -> None:
    assert not {{ python_package_name }}.run('')


def test_run_round_trips_unicode() -> None:
    assert {{ python_package_name }}.run('héllo wörld') == 'héllo wörld'


def test_go_version_is_stamped() -> None:
    assert len({{ python_package_name }}.go_version().split()) == 3


def test_cli_reads_stdin() -> None:
    result = subprocess.run(
        [sys.executable, '-m', '{{ python_package_name }}._cli'],
        input='  hello  ',
        capture_output=True,
        text=True,
        check=True,
    )
    assert result.stdout == 'hello'
