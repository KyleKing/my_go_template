"""Python bindings for the {{ project_name }} Go library."""

from __future__ import annotations

import ctypes
import sys
from pathlib import Path
from threading import Lock

__version__ = '0.0.0'

_LIB_STEM = '_lib{{ python_package_name | replace("_", "") }}'
_LIB_SUFFIXES = {'darwin': '.dylib', 'win32': '.dll'}

_lib: ctypes.CDLL | None = None
_lib_lock = Lock()


class {{ cgo_export_prefix }}Error(Exception):
    """Raised when the Go library rejects its input."""


def _library_path() -> Path:
    suffix = _LIB_SUFFIXES.get(sys.platform, '.so')
    return Path(__file__).parent / f'{_LIB_STEM}{suffix}'


def _load() -> ctypes.CDLL:
    """Open the shared library, binding argument and return types once.

    Loading is deferred to the first call because the Go runtime does not survive
    fork() without exec(). Importing this module stays safe for a process that
    forks; calling into it before forking is not.
    """
    global _lib  # ruff: ignore[global-statement]
    with _lib_lock:
        if _lib is not None:
            return _lib

        lib = ctypes.CDLL(str(_library_path()))
        lib.{{ cgo_export_prefix }}Run.argtypes = [ctypes.c_char_p, ctypes.POINTER(ctypes.c_char_p)]
        lib.{{ cgo_export_prefix }}Run.restype = ctypes.c_void_p
        lib.{{ cgo_export_prefix }}Version.argtypes = []
        lib.{{ cgo_export_prefix }}Version.restype = ctypes.c_void_p
        lib.{{ cgo_export_prefix }}Free.argtypes = [ctypes.c_void_p]
        lib.{{ cgo_export_prefix }}Free.restype = None
        _lib = lib
        return lib


def _take(lib: ctypes.CDLL, pointer: int | None) -> str | None:
    """Copy a Go-allocated C string into Python and free the original."""
    if not pointer:
        return None
    try:
        raw = ctypes.cast(pointer, ctypes.c_char_p).value
        return raw.decode() if raw is not None else None
    finally:
        lib.{{ cgo_export_prefix }}Free(pointer)


def run(text: str) -> str:
    """Pass text through the Go library and return its output."""
    lib = _load()
    error = ctypes.c_char_p()
    pointer = lib.{{ cgo_export_prefix }}Run(text.encode(), ctypes.byref(error))
    message = _take(lib, ctypes.cast(error, ctypes.c_void_p).value)
    if message is not None:
        raise {{ cgo_export_prefix }}Error(message)
    if pointer is None:
        raise {{ cgo_export_prefix }}Error('{{ project_name }} returned no output')
    return _take(lib, pointer) or ''


def go_version() -> str:
    """Return the version, commit, and build date stamped into the Go library."""
    lib = _load()
    return _take(lib, lib.{{ cgo_export_prefix }}Version()) or ''
