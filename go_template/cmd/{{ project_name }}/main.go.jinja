// Package main implements {{ project_name }}: {{ project_description }}
package main

import (
	"fmt"
	"io"
	"os"
)

var (
	version = "dev"
	commit  = "none"
	date    = "unknown"
)

func main() {
	os.Exit(report(run(os.Args[1:], os.Stdout), os.Stderr))
}

// report prints err, if there is one, and answers the exit code.
func report(err error, stderr io.Writer) int {
	if err == nil {
		return 0
	}

	fmt.Fprintf(stderr, "Error: %v\n", err) //nolint:errcheck // stderr is the last place left to report to

	return 1
}

// help is what -h and --help print.
const help = `{{ project_name }} - {{ project_description }}

Usage:
  {{ project_name }} [options]

Options:
  -h, --help     Show this help message
  -v, --version  Show version information
`

// run is the whole program behind main, taking its arguments and output so a
// test can drive it in process.
func run(args []string, stdout io.Writer) error {
	// Replace this stub with the real entry point, delegating to internal/.
	text := "{{ project_name }}: Not yet implemented\n"

	if len(args) > 0 {
		switch args[0] {
		case "-v", "--version":
			text = fmt.Sprintf("{{ project_name }} %s (commit: %s, built: %s)\n", version, commit, date)
		case "-h", "--help":
			text = help
		}
	}

	if _, err := io.WriteString(stdout, text); err != nil {
		return fmt.Errorf("writing output: %w", err)
	}

	return nil
}
{%- endif %}
