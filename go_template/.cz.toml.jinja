[tool.commitizen]
name = "cz_conventional_commits"
version = "0.0.0"
{%- if publish_python %}
version_files = [
  ".cz.toml:^version",
  "bindings/python/{{ python_package_name }}/_core.py:^__version__",
  "pyproject.toml:^version",
]
{%- else %}
version_files = [".cz.toml:^version"]
{%- endif %}
tag_format = "v$version"
# goreleaser and the Go module proxy both reject a pep440 prerelease such as 0.1.0rc2
version_scheme = "semver"
update_changelog_on_bump = true
