[tasks.bench]
description = "Run benchmarks"
run = "go test -bench=. -benchmem -run=^$ ./..."
{%- if project_type == 'cli' %}

[tasks.build]
description = "Build binary"
run = "go build -v -o {{ project_name }} ./cmd/{{ project_name }}"

[tasks.ci]
description = "Run all checks (used in GitHub Actions)"
run = [
  "go test -v -coverprofile=coverage.out ./...",
  "go build -v -o {{ project_name }} ./cmd/{{ project_name }}"
]
{%- else %}

[tasks.build]
description = "Build packages"
run = "go build -v ./..."

[tasks.ci]
description = "Run all checks (used in GitHub Actions)"
run = ["go test -v -coverprofile=coverage.out ./...", "go build -v ./..."]
{%- endif %}

[tasks.clean]
description = "Clean build artifacts"
run = "rm -f coverage.out"

[tasks.demo]
description = "Generate VHS demo recordings"
run = 'find . -name "*.tape" -not -path "./.git/*" -exec vhs {} \;'
depends = ["build"]

{%- if project_type == 'cli' %}

[tasks.dev]
description = "Run from source (always reflects current code, no stale build)"
run = "go run ./cmd/{{ project_name }}"
raw_args = true
{%- endif %}

[tasks.format]
description = "Format code with golangci-lint and golines"
run = ["golangci-lint run --fix ./...", "golines -w -m 120 ."]

[tasks.hooks]
description = "Run git hooks"
run = "hk fix --quiet"

[tasks.lint]
description = "Run linter"
run = "golangci-lint run ./..."
raw_args = true

{%- if publish_python %}

[tasks."python:build"]
description = "Build the platform wheel (compiles the c-shared library)"
run = "uv build --wheel --out-dir dist"

[tasks."python:lint"]
description = "Lint the Python bindings"
run = "uv run ruff check bindings/python"

[tasks."python:test"]
description = "Run the Python binding tests"
run = "uv run pytest"

[tasks."python:types"]
description = "Type check the Python bindings"
run = "uv run ty check"
{%- endif %}

[tasks.test]
description = "Run tests with coverage"
run = "go test -coverprofile=coverage.out ./..."
raw_args = true

[tasks."test:coverage-min"]
description = "Verify minimum coverage threshold (70%)"
run = '''
go test -coverprofile=coverage.out -coverpkg=./... ./...
coverage=$(go tool cover -func=coverage.out | grep total | awk '{print $3}' | sed 's/%//')
echo "Current coverage: ${coverage}%"
if (( $(awk "BEGIN {print ($coverage < 70)}") )); then
    echo "Coverage ${coverage}% is below 70% minimum threshold"
    exit 1
fi
'''

[tasks."test:view-coverage"]
description = "View coverage report in browser"
run = "go tool cover -html=coverage.out"

# Every version here comes from copier.yml, which is the one place they are
# defined, so mise and the workflows can never disagree. "latest" is deliberately
# absent: a formatter or linter that resolves differently on a laptop than on a
# runner fails only in CI, which is the worst place to find out.
# PLANNED: hand these pins to doner (../doner) once it reads mise TOML as well as
# Dockerfiles, so they update on its schedule instead of by hand.
[tools]
actionlint = "{{ actionlint_version }}"
go = "{{ go_version }}"
"go:github.com/golangci/golines" = "{{ golines_version }}"
"golangci-lint" = "{{ golangci_lint_version }}"
hk = "{{ hk_version }}"
jq = "{{ jq_version }}"
ls-lint = "{{ ls_lint_version }}"
"pipx:commitizen" = "{{ commitizen_version }}"
"pipx:yamllint" = "{{ yamllint_version }}"
pkl = "{{ pkl_version }}"
{%- if publish_python %}
python = "{{ python_version }}"
{%- endif %}
shellcheck = "{{ shellcheck_version }}"
tombi = "{{ tombi_version }}"
typos = "{{ typos_version }}"
{%- if publish_python %}
uv = "{{ uv_version }}"
{%- endif %}
